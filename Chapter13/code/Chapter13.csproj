<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>TravelBooking.Chapter13</RootNamespace>
	<AssemblyName>TravelBooking.Chapter13</AssemblyName>
	<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
	<!-- Reference snippet files (ch13_*.cs) are verbatim chapter listings.
		 They include framework-specific dependencies and overlapping definitions
		 and are intentionally excluded from compilation. -->
    <Compile Remove="ch13_*.cs" />
    <None Include="ch13_*.cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

</Project>
