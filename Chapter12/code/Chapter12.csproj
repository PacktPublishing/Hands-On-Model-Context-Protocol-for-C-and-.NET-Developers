<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>TravelBooking.Chapter12</RootNamespace>
	<AssemblyName>TravelBooking.Chapter12</AssemblyName>
	<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
	<!-- Reference snippet files (ch12_*.cs) are verbatim chapter listings.
		 They include overlapping types and framework-specific dependencies that
		 are not intended to compile together in this single runnable project.
		 They are kept as reading material, while runnable adaptations live in
		 Demos.cs and Program.cs. -->
    <Compile Remove="ch12_*.cs" />
    <None Include="ch12_*.cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

</Project>
